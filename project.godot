; Engine configuration file.
config_version=5

[application]

config/name="Rustfall: Colony Cleanup"
config/description="Clear red dust off a Martian colony. Includes a built-in cross-OS benchmark."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/delta_smoothing=false
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.08, 0.04, 0.03, 1)
config/icon="res://icon.svg"

[audio]

general/text_to_speech=true

[autoload]

Config="*res://scripts/config.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"
3d/default_gravity=3.72

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver="vulkan"
rendering_device/driver.windows="vulkan"
rendering_device/driver.linuxbsd="vulkan"
textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_clear_color=Color(0.08, 0.04, 0.03, 1)

[shader_globals]

focus_hex={
"type": "vec2",
"value": Vector2(0, 0)
}
hex_overlay={
"type": "float",
"value": 1.0
}
terrain_pom={
"type": "float",
"value": 10.0
}
sun_xz={
"type": "vec2",
"value": Vector2(0.5, 0.7)
}
